{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixiu.dev/schemas/ops/settings-proposal.v1.json",
  "title": "Pixiu Settings Proposal v1",
  "type": "object",
  "required": ["schema", "strategy_id", "changes", "reason"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "pixiu.settings.proposal.v1"
    },
    "strategy_id": {
      "type": "string"
    },
    "base_version": {
      "type": "string",
      "description": "Optional remote settings version or checksum used for optimistic concurrency."
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["manual", "replay", "optimize", "import"]
        },
        "replay_id": {"type": "string"},
        "case_id": {"type": "string"},
        "report_path": {"type": "string"}
      },
      "additionalProperties": true
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "value"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Dot path or JSON pointer understood by the provider."
          },
          "value": true,
          "old_value": true,
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "max_drawdown": {"type": ["number", "string"]},
        "max_orders": {"type": "integer"},
        "max_order_size": {"type": "number"},
        "min_free_margin": {"type": "number"}
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

